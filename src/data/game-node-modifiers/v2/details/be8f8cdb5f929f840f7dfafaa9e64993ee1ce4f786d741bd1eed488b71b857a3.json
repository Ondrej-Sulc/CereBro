ModSource":"1","Modifier":1.0,"Priority":0,"RatingConst":0.0,"RatingCurve":"none","Stackable":1,"SubTarget":"","Target":"self","Trigger":"onSpecialFinished","TriggerMod":-1.0,"TriggerModStr":"level=special1","TriggerRate":3,"Type":"purge","TypeMod":"type=nec_shang_chi","Var":"","_uiTrigger":"always"}}],"definitionHash":"8530bbbcf13c59bf72a551fe7c4d835c2bf1e1fa431a39fde7e98cb1a23446c7","hash":"4974f3adfd177ef04365eee3e28da951cac2b55005abab8ca66b41dd12338b6d","missingComponentIds":[],"nativeIconKey":null,"raw":{"buffStatMods":null,"buffType":"statMods","displayValue":0.0,"glyphIcon":"","group":"pve","iconTexture":"","id":"nec_path_shang","localizedDesc":"Shang-Chi has 3 cumulative phases that grant permanent additional effects in this fight.\nPhase 1 - Fight Start: Shang-Chi performs his Wushu Strikes when the Attacker performs the corresponding combos as though he had performed the combos himself. Whenever the Attacker lands a Heavy Attack, all Unreadied Wushu Strikes are Readied. Whenever Shang-Chi finishes his Special Attack 1 he loses 1 Chi Charge. If Shang-Chi activates a Special Attack while he has no Chi Charges, the Attacker is dealt a burst of Direct Damage equal to 15% of their max Health.\nPhase 2 - Defender goes below 70% Health: If the Attacker lands a combo that would trigger one of Shang-Chi's Unreadied Wushu Strikes, the Attacker is dealt a burst of Direct Damage equal to 15% of their max Health.\nPhase 3 - Defender goes below 40% Health: The Attacker's Heavy Attacks no longer Ready Wushu Strikes. Instead, when all Wushu Strikes become Unreadied, all Stun effects on the Attacker are removed and all Wushu Strikes become Readied.","localizedName":"Necrotic Boon - Wushu Strikes","localizedShortFormat":"","modesAvail":[],"modesUnavail":[],"quantity":1,"scope":{"name":"User","value":2},"tags":"","tagsList":[""],"value":0.0,"valueStr":["nec_path_shang_start","nec_path_shang_70","nec_path_shang_40","nec_path_shang_clear","nec_path_shang_icon_1","nec_path_shan