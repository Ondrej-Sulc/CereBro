{"catalogHash":"9b61e25e4b3ab6b03de3cdf4a596bd440566c4e37005c9524d39027c299eea8e","contract":"cerebro.node-modifier-detail/v2","definition":{"id":"nec_path_shang","versions":[{"applications":[{"evidence":{"coordinate":{"x":46,"y":41},"pointer":"/map/walkableTiles/357/defenderBuffs/4","sourceId":"map-c3cb045203ee79fcc186-2026eb5a"},"hash":"5304f306866e3735e691e43c7c821ed454602b933192ea7c3fca1664280869f3","nativeIconKey":null,"observations":3,"raw":{"buffAmount":1,"buffAppearance":"","buffDescription":"Shang-Chi has 3 cumulative phases that grant permanent additional effects in this fight.\nPhase 1 - Fight Start: Shang-Chi performs his Wushu Strikes when the Attacker performs the corresponding combos as though he had performed the combos himself. Whenever the Attacker lands a Heavy Attack, all Unreadied Wushu Strikes are Readied. Whenever Shang-Chi finishes his Special Attack 1 he loses 1 Chi Charge. If Shang-Chi activates a Special Attack while he has no Chi Charges, the Attacker is dealt a burst of Direct Damage equal to 15% of their max Health.\nPhase 2 - Defender goes below 70% Health: If the Attacker lands a combo that would trigger one of Shang-Chi's Unreadied Wushu Strikes, the Attacker is dealt a burst of Direct Damage equal to 15% of their max Health.\nPhase 3 - Defender goes below 40% Health: The Attacker's Heavy Attacks no longer Ready Wushu Strikes. Instead, when all Wushu Strikes become Unreadied, all Stun effects on the Attacker are removed and all Wushu Strikes become Readied.","isExtra":false,"nodeSource":{"attk":false,"bt":[],"buffs":[{"Action":"","Data":"nec_path_shang","Footer":"","Header":"","MaxQuantity":1,"MinQuantity":1,"Quantity":1,"Type":"buff"}],"remainActive":false,"type":{"name":"Local","value":2}}},"text":"Shang-Chi has 3 cumulative phases that grant permanent additional effects in this fight.\nPhase 1 - Fight Start: Shang-Chi performs his Wushu Strikes when the Attacker performs the corresponding combos as though he had performed the combos himself. Whenever the Attacker lands a Heavy Attack, all Unreadied Wushu Strikes are Readied. Whenever Shang-Chi finishes his Special Attack 1 he loses 1 Chi Charge. If Shang-Chi activates a Special Attack while he has no Chi Charges, the Attacker is dealt a burst of Direct Damage equal to 15% of their max Health.\nPhase 2 - Defender goes below 70% Health: If the Attacker lands a combo that would trigger one of Shang-Chi's Unreadied Wushu Strikes, the Attacker is dealt a burst of Direct Damage equal to 15% of their max Health.\nPhase 3 - Defender goes below 40% Health: The Attacker's Heavy Attacks no longer Ready Wushu Strikes. Instead, when all Wushu Strikes become Unreadied, all Stun effects on the Attacker are removed and all Wushu Strikes become Readied."}],"componentIds":["nec_path_shang_start","nec_path_shang_70","nec_path_shang_40","nec_path_shang_clear","nec_path_shang_icon_1","nec_path_shang_icon_2","nec_path_shang_icon_3","nec_path_shang_start_2","nec_path_shang_start_3","nec_path_shang_m1_trig","nec_path_shang_l1_trig","nec_path_shang_l2_trig","nec_path_shang_l3_trig","nec_path_shang_blk_m1_trig","nec_path_shang_blk_l1_trig","nec_path_shang_blk_l2_trig","nec_path_shang_blk_l3_trig","nec_path_shang_slow_hit_seq","nec_path_shang_slow_blk_seq","nec_path_shang_clns_hit_seq","nec_path_shang_clns_blk_seq","nec_path_shang_unblk_hit_seq","nec_path_shang_unblk_blk_seq","nec_path_shang_stun_hit_seq","nec_path_shang_stun_blk_seq","nec_path_shang_hvy_seq","nec_path_shang_dmg_sp","nec_path_shang_dmg_1a","nec_path_shang_dmg_1b","nec_path_shang_dmg_2a","nec_path_shang_dmg_2b","nec_path_shang_dmg_3a","nec_path_shang_dmg_3b","nec_path_shang_dmg_4a","nec_path_shang_dmg_4b","nec_path_shang_stun_shield","nec_path_shang_rst_b","nec_path_shang_chi_rmv"],"components":[{"hash":"24be338b2d9159b10e2a9a5497f20d9f2864d8e11c0cd6e530657ea1cac09dd8","id":"nec_path_shang_start","raw":{"AppearanceID":"nec_phase_info","Chance":1.0,"ChanceSource":"1","DurSource":"1","Duration":-1.0,"Gr