{"catalogHash":"9b61e25e4b3ab6b03de3cdf4a596bd440566c4e37005c9524d39027c299eea8e","contract":"cerebro.node-modifier-detail/v2","definition":{"id":"pve_higher_further_faster","versions":[{"applications":[{"evidence":{"coordinate":{"x":6,"y":3},"pointer":"/map/walkableTiles/5/defenderBuffs/5","sourceId":"map-beecc05659a5b437ea84-2026eb5a"},"hash":"cdc206e9de3c0117db402c06460ab1aa7bc1177b08b56efcda80900fd41db466","nativeIconKey":null,"observations":3,"raw":{"buffAmount":1,"buffAppearance":"|","buffDescription":"The Defender gains 5% of Max Power each time their Block is hit.\\n\\nThe Defender gains 1 Binary Charge every 0.4 seconds, and 5 every time the Attacker Blocks a hit. At 99, they trigger Ignition for 20 seconds, paused during the Defender’s Heavy Attacks. Charges cannot be gained until Ignition ends.\\n\\nIgnition grants Stun Immunity and a 100% chance to Auto-Block Light and Medium Attacks. Additionally, Special Attacks cost 75% less Power and cannot be avoided with the Dexterity Mastery. If the Defender’s Specials are Well-Timed Blocked, the Attacker gains 5% of missing Power and a 50% Vigor Passive for 10 seconds, paused while Ignition is still active. These Vigors cannot fail due to Ability Accuracy and cannot expire during the Attacker’s Specials","isExtra":false,"nodeSource":{"attk":false,"bt":[],"buffs":[{"Action":"","Data":"pve_higher_further_faster","Footer":"","Header":"","MaxQuantity":1,"MinQuantity":1,"Quantity":1,"Type":"buff"},{"Action":"","Data":"pve_boxin_2","Footer":"","Header":"","MaxQuantity":1,"MinQuantity":1,"Quantity":1,"Type":"buff"},{"Action":"","Data":"pve_a8_ride_block_3","Footer":"","Header":"","MaxQuantity":1,"MinQuantity":1,"Quantity":1,"Type":"buff"},{"Action":"","Data":"avx_fry","Footer":"","Header":"","MaxQuantity":1,"MinQuantity":1,"Quantity":1,"Type":"buff"},{"Action":"","Data":"ava_use_spall","Footer":"","Header":"","MaxQuantity":1,"MinQuantity":1,"Quantity":1,"Type":"buff"}],"remainActive":false,"type":{"name":"Local","value":2}}},"text":"The Defender gains 5% of Max Power each time their Block is hit.\\n\\nThe Defender gains 1 Binary Charge every 0.4 seconds, and 5 every time the Attacker Blocks a hit. At 99, they trigger Ignition for 20 seconds, paused during the Defender’s Heavy Attacks. Charges cannot be gained until Ignition ends.\\n\\nIgnition grants Stun Immunity and a 100% chance to Auto-Block Light and Medium Attacks. Additionally, Special Attacks cost 75% less Power and cannot be avoided with the Dexterity Mastery. If the Defender’s Specials are Well-Timed Blocked, the Attacker gains 5% of missing Power and a 50% Vigor Passive for 10 seconds, paused while Ignition is still active. These Vigors cannot fail due to Ability Accuracy and cannot expire during the Attacker’s Specials"}],"componentIds":["pve_rol_cm_ui","pve_rol_cm_hud","pve_rol_cm_var","pve_rol_pwr_block","pve_rol_cm_dummy_timer","pve_rol_cm_dummy_timer_seq","pve_rol_cm_var_att_block_1","pve_rol_cm_ab_buff","pve_rol_cm_ab","pve_rol_cm_bin_pause","pve_rol_cm_bin_pause_rmv","pve_rol_cm_stn_imm","pve_rol_cm_stn_imm_rmv","pve_rol_cm_rmv_hud","pve_rol_cm_reset_var","pve_rol_cm_pwr_eff","pve_rol_cm_no_dex","pve_rol_cm_no_dex_rmv","pve_rol_cm_power_attk","pve_rol_cm_vigor","pve_rol_cm_vigor_lock","pve_rol_cm_vigor_pause","pve_rol_cm_vigor_pause_rmv","pve_rol_cm_vigor_dummy","pve_rol_cm_vigor_pause_exp_sp","pve_rol_cm_vigor_pause_exp_rmv"],"components":[{"hash":"3643f00d3b5e83a1ccaac701ebd188c6f8ded939d2a1f84a9e5df321bab99563","id":"pve_rol_cm_ui","raw":{"AppearanceID":"rol_cm_hud","Chance":0.75,"ChanceSource":"1","DurSource":"1","Duration":12.0,"GrowthCurve":"none","GrowthTarget":"","HUDPriority":0,"HeroRatingAttack":0.0,"HeroRatingHP":0.0,"ID":"pve_rol_cm_ui","ModSource":"1","Modifier":0.4000000059604645,"Priority":0,"RatingConst":0.0,"RatingCurve":"none","Stackable":50,"SubTarget":"","Target":"self","Trigger":"none","TriggerMod":-1.0,"TriggerRate":2,"Type":"dummy_ui","Var":"","_uiTrigger":""}},{"hash":"19fbc2d58dfe962e985d