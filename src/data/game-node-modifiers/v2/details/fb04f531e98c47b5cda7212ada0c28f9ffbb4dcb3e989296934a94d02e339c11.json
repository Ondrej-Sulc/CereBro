 [k=glossary/prowess]Prowess[/k] Passives.\\n•[k=glossary/intercept]Intercepting[/k] Winter Soldier transfers one Prowess to the Attacker and Passively Regenerates them {2}% Health. Cooldown: 10 seconds.\\n\\nWinter Soldier prevents the Attacker’s Regeneration Rate from increasing, he cannot Miss or use Special 1, and during his Special 2 he prevents the Attacker from healing.","localizedName":"I'm Not Your Punching Bag Anymore","localizedShortFormat":"","modesAvail":[],"modesUnavail":[],"quantity":1,"scope":{"name":"User","value":2},"tags":"","tagsList":[""],"value":0.0,"valueStr":["pve_rol_ws_ui","pve_rol_ws_rmv_abilities","pve_rol_ws_agg_hud","pve_rol_ws_agg_var","pve_rol_ws_phs_chargeadd_ph_3_sp1","pve_rol_ws_phs_chargeadd_ph_3_sp2","pve_rol_ws_phs_chargeadd_ph_3_sp3","pve_rol_ws_host_set_app_1","pve_rol_ws_host_set_app_2","pve_rol_ws_host_set_app_3","pve_rol_ws_host_set_app_4","pve_rol_ws_host_hud_setapp_1","pve_rol_ws_host_hud_setapp_2","pve_rol_ws_host_hud_setapp_3","pve_rol_ws_host_hud_setapp_4","pve_rol_ws_wounded_callout","pve_rol_ws_wounded_seq","pve_rol_ws_agg_var_reset","pve_rol_ws_host_set_app_rmv","pve_rol_ws_agg_hud_wound_rmv","pve_rol_ws_wounded","pve_rol_ws_wounded_dmg","pve_rol_ws_wounded_powerlock","pve_rol_ws_prowess","pve_rol_ws_prowess_seq","pve_rol_ws_prowess_seq_phs2","pve_rol_ws_prowess_att_seq","pve_rol_ws_prowess_rmv","pve_rol_ws_prowess_trnsfr","pve_rol_ws_prowess_regen","pve_rol_ws_prowess_callout_timer","pve_rol_ws_prowess_callout_refresh","pve_rol_ws_prowess_callout","pve_rol_ws_prowess_callout_pause","pve_rol_ws_regen_lock","pve_rol_ws_sp1_lock","pve_rol_ws_no_miss","pve_rol_ws_no_miss_call","pve_rol_ws_heal_bl_sp2","pve_rol_ws_heal_bl_sp_rmv"],"valueType":{"name":"String","value":3}},"sourceBcgSha256":"b821489b5451d1d6ee0927f39a80d964f6c1d3aaf13bd76531e5f77d93deba8e"}]},"projection":{"contentHash":"cbd54c0e4629b63f059c279a292f58a0512ad5c173ca93cae27b9a99b92733fc","contract":"cerebro.node-modifier-uses/v2","modifierCatalogHash":"9b61