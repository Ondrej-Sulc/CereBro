{"catalogHash":"9b61e25e4b3ab6b03de3cdf4a596bd440566c4e37005c9524d39027c299eea8e","contract":"cerebro.node-modifier-detail/v2","definition":{"id":"pve_gamma_rage","versions":[{"applications":[{"evidence":{"coordinate":{"x":8,"y":15},"pointer":"/map/walkableTiles/23/defenderBuffs/5","sourceId":"map-beecc05659a5b437ea84-2026eb5a"},"hash":"fafd46cc129832d2db3c9f20d53b7a835976e6cc22796239569f4fd3ad101c8c","nativeIconKey":null,"observations":3,"raw":{"buffAmount":1,"buffAppearance":"%","buffDescription":"The Attacker starts with a dormant Fury timer for 20 seconds, starting paused. Striking the Defender inflicts or refreshes a non-stacking +90% [k=glossary/fragility]Fragility[/k] Passive for 3 seconds, paused during the Defender's Specials. While this Fragility is active, the Fury timer unpauses and expires more quickly based on how long the Fragility has been active. When the Fury timer ends, the Attacker gains an indefinite +10% [k=glossary/fury]Fury[/k] Passive and the timer restarts.\\n\\nIf the Fragility ends, the Defender gains a Gamma Rage Charge. If the Defender reaches 5 Charges they become Passively [k=glossary/unblockable]Unblockable[/k] and [k=glossary/unstoppable]Unstoppable[/k], and more aggressive for 10 seconds.","isExtra":false,"nodeSource":{"attk":false,"bt":[],"buffs":[{"Action":"","Data":"pve_gamma_rage","Footer":"","Header":"","MaxQuantity":1,"MinQuantity":1,"Quantity":1,"Type":"buff"},{"Action":"","Data":"pve_cmbomt_2","Footer":"","Header":"","MaxQuantity":1,"MinQuantity":1,"Quantity":1,"Type":"buff"},{"Action":"","Data":"nec_trap_predict","Footer":"","Header":"","MaxQuantity":1,"MinQuantity":1,"Quantity":1,"Type":"buff"},{"Action":"","Data":"pve_despair_3","Footer":"","Header":"","MaxQuantity":1,"MinQuantity":1,"Quantity":1,"Type":"buff"},{"Action":"","Data":"ava_limber10","Footer":"","Header":"","MaxQuantity":1,"MinQuantity":1,"Quantity":1,"Type":"buff"},{"Action":"","Data":"ava_use_sp2","Footer":"","Header":"","MaxQuantity":1,"MinQuantity":1,"Qua