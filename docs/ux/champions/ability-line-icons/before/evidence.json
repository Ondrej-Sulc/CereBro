          },
          {
            "expanded": "false",
            "text": "20"
          },
          {
            "expanded": "false",
            "text": "20"
          }
        ],
        "text": "Inflict a non-stacking Taunt Debuff for 10 seconds, reducing their Attack Rating by 20%. This ability goes on cooldown for 20 second(s) if activated."
