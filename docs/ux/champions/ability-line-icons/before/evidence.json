      {
        "headings": [
          "Molecular Duplication - Always Active",
          "Omni-Morph Forms",
          "Refined Forms",
          "Morph Charges"
        ],
        "height": 2770,
        "id": "dossier-base-abilities"
      }
    ],
    "records": [
      {
        "id": "ability-record-78995",
        "links": [
          {
            "expanded": "false",
            "text": "20"
          },
          {
            "expanded": "false",
            "text": "Critical Penetration"
          },
          {
            "expanded": "false",
            "text": "20"
          }
        ],
        "text": "A fluid molecular structure grants Absorbing Man 20% Crit Resistance and Immunity to Armor Break and Armor Shattered Debuffs, but reduces his Critical Penetration by 20% flat."
      },
      {
        "id": "ability-record-78996",
        "links": [
          {
            "expanded": "false",
            "text": "90"
          }
        ],
        "text": "Absorbing Man is no stranger to brawling with beings of otherworldly resilience. He reduces the duration of his Opponent’s Indestructible, Immortality, Unstoppable, and Unblockable Buffs by 90%."
      },
      {
        "id": "ability-record-78997",
        "links": [],
        "text": "Absorbing Man’s Special Attacks transform him into powerful altered Forms. He can only be in one Form at a time, and Form changes cannot fail due to Ability Accuracy Modification."
      },
      {
        "id": "ability-record-79002",
        "links": [],
        "text": "Absorbing Man starts each fight in his Black Uru Form by default, but can use the Pre-Fight Menu to change this default, which persists until changed again."
      },
      {
        "id": "ability-record-79003",
        "links": [
          {
            "expanded": "false",
            "text": "20"
          }
        ],
        "text": "Being struck by a Heavy Attack while recovering from a Special Attack deactivates the current Form, which cannot be deactivated again in this way for 20 seconds."
      },
      {
        "id": "ability-record-79005",
        "links": [
          {
            "expanded": "false",
            "text": "3"
          }
        ],
        "text": "Whenever a Buff ends on the Opponent or Absorbing Man is Immune to a Debuff, the current Form pauses for 3 seconds."
      },
      {
        "id": "ability-record-79007",
        "links": [
          {
            "expanded": "false",
            "text": "6"
          },
          {
            "expanded": "false",
            "text": "485.29"
          },
          {
            "expanded": "false",
            "text": "Vulnerability"
          },
          {
            "expanded": "false",
            "text": "15"
          }
        ],
        "text": "Interrupting an Opponent's Basic Attack with a Light Attack pauses the current Form for 6 seconds and inflicts a 485.29 potency Vulnerability Passive for 15 seconds. Max Stacks: 5."
      },
      {
        "id": "ability-record-79009",
        "links": [],
        "text": "If Absorbing Man would enter a Form that is already active, he instead Refines the Form, refreshing its duration and granting additional benefits."
      },
      {
        "id": "ability-record-79010",
        "links": [
          {
            "expanded": "false",
            "text": "300"
          }
        ],
        "text": "Personal bursts of damage benefit from 300% of Absorbing Man's Critical Damage Multiplier when he lands a Critical Hit and cannot have their Ability Accuracy modified."
      },
      {
        "id": "ability-record-79012",
        "links": [
          {
            "expanded": "false",
            "text": "Unblockable"
          }
        ],
        "text": "Special Attacks are Passively Unblockable."
      },
      {
        "id": "ability-record-79013",
        "links": [
          {
            "expanded": "false",
            "text": "72"
          }
        ],
        "text": "Blocking a Hit reduces the Opponent’s Ability Power Rate by 72% until Absorbing Man stops blocking. The Power denied is transferred to Absorbing Man."
      },
      {
        "id": "ability-record-79014",
        "links": [
          {
            "expanded": "false",
            "text": "600"
          }
        ],
        "text": "When Absorbing Man refreshes or changes Forms, he gains Morph Charges equal to the remaining percentage of his previous Form’s base duration. Max 600."
      },
      {
        "id": "ability-record-79015",
        "links": [
          {
            "expanded": "false",
            "text": "90"
          }
        ],
        "text": "Whenever Absorbing Man is Immune to an Armor Break or Armor Shattered Debuff, he gains 90 Morph Charges."
      },
      {
        "id": "ability-record-79016",
        "links": [
          {
            "expanded": "false",
            "text": "150"
          },
          {
            "expanded": "false",
            "text": "30"
          },
          {
            "expanded": "false",
            "text": "Vulnerability"
          },
          {
            "expanded": "false",
            "text": "2,750"
          },
          {
            "expanded": "false",
            "text": "150"
          }
        ],
        "text": "Performing a Medium, Light, Medium Combo with at least 150 Morph Charges, or activating a Special Attack at max charges consumes available Charges to Refine the current Form and inflict one 30 second Vulnerability Passive with 2,750 potency for every 150 Charges consumed."
      },
      {
        "id": "ability-record-79019",
        "links": [
          {
            "expanded": "false",
            "text": "2,250"
          }
        ],
        "text": "This attack gains 2,250 Critical Rating if the Opponent is Stunned as the first hit lands."
      },
      {
        "id": "ability-record-79020",
        "links": [
          {
            "expanded": "false",
            "text": "24,749.99"
          }
        ],
        "text": "This attack instead gains 24,749.99 Critical Rating if the Opponent is not Stunned as the first hit lands."
      },
      {
        "id": "ability-record-79021",
        "links": [
          {
            "expanded": "false",
            "text": "30"
          }
        ],
        "text": "Activating a Special Attack after the first hit lands applies this bonus Critical Rating to the entire Special and grants 30 Morph Charges."
      },
      {
        "id": "ability-record-79023",
        "links": [
          {
            "expanded": "false",
            "text": "11,000"
          }
        ],
        "text": "Gain Immunity to all Bleed and Shock effects and +11,000 Physical Resistance."
      },
      {
        "id": "ability-record-79024",
        "links": [
          {
            "expanded": "false",
            "text": "2,014.2"
          }
        ],
        "text": "All attacks deal a burst of 2,014.2 Physical Damage."
      },
      {
        "id": "ability-record-79025",
        "links": [],
        "text": "Refined: Absorbing Man can perform Critical Hits and trigger personal bursts of damage through the Opponent’s Block."
      },
      {
        "id": "ability-record-79027",
        "links": [
          {
            "expanded": "false",
            "text": "11,000"
          }
        ],
        "text": "Gain Immunity to all Incinerate, Coldsnap, and Frostbite effects and +11,000 Energy Resistance."
      },
      {
        "id": "ability-record-79028",
        "links": [
          {
            "expanded": "false",
            "text": "2,014.2"
          }
        ],
        "text": "All attacks deal Energy Damage instead of Physical, as well as a burst of 2,014.2 Energy Damage."
