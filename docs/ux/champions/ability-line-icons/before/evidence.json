          },
          {
            "expanded": "false",
            "text": "7"
          }
        ],
        "text": "Inflict an indefinite Special Concussion Debuff, reducing Ability Accuracy by 10% during Special attacks. Max 7."
      },
      {
        "id": "ability-record-84347",
        "links": [
          {
            "expanded": "false",
            "text": "3"
          }
        ],
        "text": "Reducing a Combo of 3 or more to a lower amount removes one stack of Special Concussion."
      },
